# JafariPay — production environment template
# ============================================================================
# Copy to .env and fill in real values. DO NOT commit .env. NEVER put a secret
# value in this template. This file documents WHICH vars exist and their class;
# it is not a second config system — selection still comes only from these vars.
#
# Boot guard: with NODE_ENV=production the server REFUSES TO START unless the
# full production configuration is coherent — the four secrets below (each
# present and >= 16 chars), ALLOWED_ORIGINS / CHECKOUT_BASE_URL / JAFARIPAY_DOMAIN
# (set, https, well-shaped), an explicit known EMAIL_TRANSPORT (with complete
# Brevo credentials when brevo_smtp is selected), RPC-proxy token/chains when a
# proxy base URL is set, and NO testnet E2E signer keys (see
# server/lib/production-config.ts; only variable NAMES are ever printed).

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production                 # PRODUCTION REQUIRED
PORT=3001                            # OPTIONAL (default 3001)
DATABASE_URL=./data/app.db           # PRODUCTION REQUIRED (bun:sqlite file path)

# ── Secrets (>= 16 random chars each; generate fresh, never reuse) ──────────
SESSION_SECRET=                      # PRODUCTION REQUIRED — session token signing
API_KEY_HMAC_SECRET=                 # PRODUCTION REQUIRED — API-key lookup HMAC
WEBHOOK_HMAC_SECRET=                 # PRODUCTION REQUIRED — webhook identity HMAC
# Encrypts webhook raw signing secrets at rest (AES-256-GCM). MUST be strong AND
# STABLE: changing it makes existing webhook ciphertext undecryptable, so those
# endpoints fail closed until the merchant rotates the secret.
WEBHOOK_SIGNING_ENC_KEY=             # PRODUCTION REQUIRED — at-rest encryption key

# ── Public origin / routing ──────────────────────────────────────────────────
JAFARIPAY_DOMAIN=jafari.co.in        # PRODUCTION REQUIRED — set to your domain (SIWE)
CHECKOUT_BASE_URL=https://jafari.co.in  # REQUIRED — hosted checkout base
ALLOWED_ORIGINS=https://jafari.co.in    # PRODUCTION REQUIRED — comma-separated CORS allowlist

# ── Live payments gate ───────────────────────────────────────────────────────
# Leave unset/false until you are ready to accept live (non-test) money.
ENABLE_LIVE_PAYMENTS=false           # PRODUCTION REQUIRED (true) to serve live keys/wallets

# ── RPC deployment model (OPTIONAL — direct curated RPC leaves these unset) ──
# Proxy mode routes registry reads through a shared RPC proxy. If RPC_PROXY_BASE_URL
# is set, RPC_PROXY_CHAINS lists the mapped chain ids and RPC_PROXY_TOKEN is the
# proxy credential; unmapped networks / missing token FAIL CLOSED.
# RPC_PROXY_BASE_URL=
# RPC_PROXY_CHAINS=
# RPC_PROXY_TOKEN=

# ── Email / receipts ─────────────────────────────────────────────────────────
# Transport selection: single env var.
#   dev         — in-memory sink, records messages (default for tests / local)
#   none        — explicit no-op, never attempts delivery
#   brevo_smtp  — Brevo SMTP relay (D-4 approved production provider)
# Unknown values safely fall through to the dev sink (never a fake real sender).
EMAIL_TRANSPORT=dev                  # OPTIONAL: dev | none | brevo_smtp

# Brevo SMTP credentials (REQUIRED when EMAIL_TRANSPORT=brevo_smtp).
# NEVER commit real values. Inject via your hosting provider's secret manager.
# These are read at transport-selection time; missing creds cause send() to
# return { ok:false, error:'brevo_smtp_missing_*' } — never a thrown exception.
EMAIL_BREVO_SMTP_LOGIN=              # Brevo SMTP login (your account email)
EMAIL_BREVO_SMTP_KEY=                # Brevo SMTP key (generated in Brevo dashboard)
EMAIL_FROM=noreply@jafari.co.in     # Branded sender — the Brevo-VERIFIED sender address

# Brevo SMTP connection overrides (OPTIONAL — defaults shown; only change if
# Brevo documentation instructs you to use a different endpoint).
# EMAIL_BREVO_SMTP_HOST=smtp-relay.brevo.com
# EMAIL_BREVO_SMTP_PORT=587
# EMAIL_BREVO_TIMEOUT_MS=15000

# NEVER set EMAIL_DEV_FAIL in production — test-only forced-failure flag.
